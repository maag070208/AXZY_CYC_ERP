# API
NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://cyc:cyc_dev_pwd@localhost:5432/cyc?schema=public

# Origen permitido para CORS en la web (una URL, o * en desarrollo).
WEB_ORIGIN=*
# URL base de la web; se usa para armar el enlace de recuperación de contraseña.
APP_URL=http://localhost:5173

# Seguridad / sesión
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Bloqueo temporal por intentos fallidos.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Política de contraseña (mínimo de caracteres).
PASSWORD_MIN_LENGTH=10

# Usuario administrador inicial. Solo se crea si la tabla `users` está vacía.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Cambiar-2026!

# Límite de subida de archivos (bytes).
UPLOAD_MAX_BYTES=52428800

# Almacenamiento privado (expediente). STORAGE_DRIVER=s3|local; vacío = S3 si
# hay credenciales, si no disco local (solo fuera de producción).
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=storage/private
# Almacenamiento S3 (opcional).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2

# Correo (Resend principal, SMTP fallback; sin ambos entra en dry-run).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT=10000
EMAIL_DRY_RUN=false

# Tiempo real (Ably). Sin clave, las publicaciones entran en dry-run.
ABLY_API_KEY=

# Límite de peticiones por IP (M12). Sin definir: 1000 fuera de producción, 20/30 en producción.
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_PUBLIC_MAX=30
# Saltos de proxy delante de la API (0 = expuesta directo; 1 = nginx/Railway).
TRUST_PROXY=0

# Respaldos (`pnpm backup` / `pnpm restore`)
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=30
