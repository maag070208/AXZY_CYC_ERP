# Copia a `.env` y ajusta. Lo consumen docker-compose y/o los proyectos.

# ===== Postgres =====
POSTGRES_DB=cyc
POSTGRES_USER=cyc
POSTGRES_PASSWORD=cyc_dev_pwd
POSTGRES_PORT=5432

# ===== API =====
API_PORT=4001
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Límite de peticiones por IP (ventana de 15 min): login cuenta solo los fallidos.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_PUBLIC_MAX=30
# Saltos de proxy delante de la API (1 = nginx de la web o Railway).
TRUST_PROXY=1
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Cambiar-2026!
# Origen(es) permitido(s) por CORS: lista separada por comas, admite comodín (https://*.dominio).
WEB_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# ===== Web =====
WEB_PORT=8080
# La web habla con la API por el proxy de nginx.
WEB_API_URL=/api/v1
VITE_API_URL=/api/v1

# ===== Almacenamiento / integraciones (opcional) =====
# Expediente: "local" (volumen apistorage) o "s3" (AWS / endpoint compatible).
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2
# Endpoint S3-compatible alterno (MinIO…). Vacío = AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ABLY_API_KEY=

# ===== Respaldos (servicio `backup`) =====
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
