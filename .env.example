# Copia a `.env` y ajusta. Lo consumen docker-compose y/o los proyectos.

# ===== Postgres =====
POSTGRES_DB=cyc
POSTGRES_USER=cyc
POSTGRES_PASSWORD=cyc_dev_pwd
POSTGRES_PORT=5432

# ===== API =====
API_PORT=4001
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Cambiar-2026!
# Origen permitido por CORS / URL pública de la web.
WEB_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# ===== Web =====
WEB_PORT=8080
# La web habla con la API por el proxy de nginx.
WEB_API_URL=/api/v1
VITE_API_URL=/api/v1

# ===== Almacenamiento / integraciones (opcional) =====
# Expediente: "local" (volumen apistorage), "s3" (AWS) o "s3" + S3_ENDPOINT (Cloudflare R2/MinIO).
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2
# Cloudflare R2 (si STORAGE_DRIVER=s3): endpoint, bucket y region "auto".
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# AWS_REGION=auto
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ABLY_API_KEY=
